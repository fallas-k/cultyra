# ══════════════════════════════════════════════
# CULTYRA SERVER — Variables de entorno
# Copiar como .env y rellenar los valores reales
# NUNCA subir .env al repositorio de GitHub
# ══════════════════════════════════════════════

# Firebase Project ID (cultyraagro)
FIREBASE_PROJECT_ID=cultyraagro

# API Key de Anthropic para CultIA
ANTHROPIC_API_KEY=sk-ant-...

# Puerto del servidor (Railway lo asigna automáticamente)
PORT=3000

# Orígenes permitidos (separados por coma, sin espacios)
ALLOWED_ORIGINS=https://cultyraagro.web.app,https://cultyraagr.web.app

# Entorno (production | development)
NODE_ENV=production
